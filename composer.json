{
    "name": "bangsamu/sso",
    "description": "login menggunakan sso sendiri",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-sodium": "*",
        "laravel/ui": "^4.6",
        "bangsamu/master": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bangsamu\\Sso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bangsamu\\Sso\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/stubs/"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bangsamu\\Sso\\SsoPackageServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "infomediaku.com",
            "email": "hatur.cms@gmail.com"
        }
    ],
    "scripts": {
        "test": "phpunit"
    }
}
